DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# 팀 리더의 Discord 사용자 ID (과제 등록·승인 권한)
LEADER_ID=
# Cloudflare Workers AI: 대시보드 AI > Workers AI > Use REST API 에서 계정 ID와 토큰 발급
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/google/gemma-4-26b-a4b-it
# 선택: Workers AI가 실패하면 Groq로 넘어감 (비워 두면 대체 없음)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DATABASE_PATH=data/pacer.db
